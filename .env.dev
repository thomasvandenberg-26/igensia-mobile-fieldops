# BEFORE DEPLOYING PUBLICLY :
# - BEWARE change all _PASSWORD, _SECRET, _API_KEY, _DEBUG_LOCAL_PORT
# - change DNS (all _RULE_ADDRESS) and possibly configure SMTP
# - change basicAuth passwords in traefik/dyn-traefik.yml

# BEWARE in docker compose, "environment" takes precedences to "env_file", so make sure
# that variables set here are not in docker-compose.dev.yml containers' "environment"

# NB. use specific vars to allow loading them in dev directly from project main ../.env.dev
# even when they could be only hardcoded in docker compose

# Pour l'appel depuis le téléphone en http plutôt que https :
# (TODO changer à votre IP locale)
LOCAL_IP=192.168.0.111
      
# TRAEFIK
TRAEFIK_RULE_ADDRESS=dashboard.localhost

# traefik examples :
APP2_RULE_ADDRESS=app2.localhost

# DB (PostgreSQL)
POSTGRES_LOCAL_PORT=15432
POSTGRES_DOCKER_PORT=5432
# db env : (BEWARE if you import / restore from another database, POSTGRES_DB must be the same)
#POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
# NB. DB passwords would not be required with POSTGRES_HOST_AUTH_METHOD=trust
# HOWEVER still setting them in case pgadmin ends up being used
DB=fieldops
DB_USER=fieldops
DB_PASSWORD=fieldops

# HASURA
HASURA_RULE_ADDRESS=hasura.localhost
HASURA_LOCAL_PORT=8080
HASURA_DOCKER_PORT=8080
# NB. all 3 databases are the same
# hasura env :
# enable debugging mode (ex. hasura actions info). Rather disable this in production
HASURA_GRAPHQL_DEV_MODE="true"
# authentication : (console, Keycloak authentication provider etc.)
HASURA_GRAPHQL_ADMIN_SECRET=fieldops

# API
API_RULE_ADDRESS=api.localhost
API_LOCAL_PORT=6868
API_DOCKER_PORT=3000
API_DEBUG_LOCAL_PORT=9229
# Au moins 32 caracteres, A REUTILISER dans un HASURA_GRAPHQL_JWT_SECRET de type HS256 :
API_AUTH_JWT_SECRET=TODOTODOTODOTODOTODOTODOTODOTODOTODOTODOTODOTODOTODOTODOTODOTODOTODOTODOTODOTODO
VITE_GOOGLE_MAPS_API_KEY=AIzaSyBag8OG_pbh29-QIh-DBzQtD2OBmh3p3wM

# PWA IONIC
PWA_RULE_ADDRESS=app.localhost
PWA_LOCAL_PORT=8101
# if minified not 8100 but 80 :
PWA_DOCKER_PORT=8100
VITE_SESSIONS_ENABLED=false
# BEWARE in dev only :
VITE_DEV_MODE_MOCK_DATA=true
VITE_DEV_MODE_MOCK_DATA=false
#VITE_DEV_MODE_NO_AUTH=true
#VITE_SESSIONS_ENABLED=true

# SMTP SERVER - dans api (et dans Keycloak realm MSP > Email)
MAIL_CONTACT=noreply@fieldops.com
SERVER_SMTP_HOST=ssl0.ovh.net
SERVER_SMTP_PORT=465
SERVER_SMTP_USER=noreply@fieldops.com
SERVER_SMTP_PASS=noreply@fieldops.com

# NB. Hasura might play the role of pgadmin outside prod when console not disabled
PGADMIN_RULE_ADDRESS=pgadmin.localhost
PGADMIN_LOCAL_PORT=8090
PGADMIN_DOCKER_PORT=80
PGADMIN_DEFAULT_PASSWORD=postgres
